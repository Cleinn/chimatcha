<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2B1E">

    <!-- Back arrow on dark bg -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_arrow_left"
        android:background="@null"
        android:padding="4dp"
        android:tint="@color/chimatcha_text_white" />

    <!-- White card that fills the bottom portion, image sits at its top -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="140dp"
        android:orientation="vertical"
        android:background="@drawable/card_top_bg">

        <!-- Drag handle / top indicator -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/card_handle" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Product image at top of white card, rounded top corners -->
                <androidx.cardview.widget.CardView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/detailImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                </androidx.cardview.widget.CardView>

                <!-- Content below image -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp">

                    <!-- Name + Price -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/detailName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="StrawMatcha"
                            android:textColor="#222222"
                            android:textSize="22sp"
                            android:fontFamily="@font/montserrat_medium" />

                        <TextView
                            android:id="@+id/detailPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp.25.000"
                            android:textColor="@color/chimatcha_primary"
                            android:textSize="18sp"
                            android:fontFamily="@font/montserrat_medium" />

                    </LinearLayout>

                    <!-- Stars + review count -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" android:tint="#FFC107" />
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" android:tint="#FFC107" />
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" android:tint="#FFC107" />
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star" android:tint="#FFC107" />
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_star_half" android:tint="#FFC107" />

                        <TextView
                            android:id="@+id/detailReviews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(23,456)"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:layout_marginStart="6dp" />

                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:id="@+id/detailDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A combination between milk matcha and strawberry fruit."
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_regular"
                        android:layout_marginBottom="20dp" />

                    <!-- Sweet Level + Ice Level -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sweet Level"
                                android:textColor="#333333"
                                android:textSize="13sp"
                                android:fontFamily="@font/montserrat_medium"
                                android:layout_marginBottom="6dp" />

                            <LinearLayout
                                android:id="@+id/sweetLevelLayout"
                                android:layout_width="match_parent"
                                android:layout_height="43dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="14dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/dropdown_bg">

                                <TextView
                                    android:id="@+id/sweetLevelText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Normal Sweet"
                                    android:textColor="#888888"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/montserrat_regular"
                                    android:singleLine="true" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down"
                                    android:tint="#888888" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ice Level"
                                android:textColor="#333333"
                                android:textSize="13sp"
                                android:fontFamily="@font/montserrat_medium"
                                android:layout_marginBottom="6dp" />

                            <LinearLayout
                                android:id="@+id/iceLevelLayout"
                                android:layout_width="match_parent"
                                android:layout_height="43dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="14dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/dropdown_bg">

                                <TextView
                                    android:id="@+id/iceLevelText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Normal Ice"
                                    android:textColor="#888888"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/montserrat_regular"
                                    android:singleLine="true" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down"
                                    android:tint="#888888" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Notes label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notes "
                            android:textColor="#333333"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(Optional)"
                            android:textColor="#888888"
                            android:textSize="13sp"
                            android:fontFamily="@font/montserrat_regular" />

                    </LinearLayout>

                    <!-- Notes input -->
                    <EditText
                        android:id="@+id/notesInput"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:hint="e.g. Less sweet, no straw, extra whipped cream..."
                        android:background="@drawable/notes_bg"
                        android:padding="14dp"
                        android:textSize="13sp"
                        android:textColor="#333333"
                        android:textColorHint="#AAAAAA"
                        android:fontFamily="@font/montserrat_regular"
                        android:inputType="textMultiLine"
                        android:gravity="top"
                        android:layout_marginBottom="20dp" />

                    <!-- Quantity row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Quantity"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:fontFamily="@font/montserrat_medium" />

                        <TextView
                            android:id="@+id/btnMinus"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:text="−"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:gravity="center"
                            android:background="@drawable/btn_primary" />

                        <EditText
                            android:id="@+id/quantityText"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#333333"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:fontFamily="@font/montserrat_medium"
                            android:inputType="number"
                            android:background="@null"
                            android:selectAllOnFocus="true" />

                        <TextView
                            android:id="@+id/btnPlus"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:gravity="center"
                            android:background="@drawable/btn_primary" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ADD TO CART pinned inside the white card at the bottom -->
        <Button
            android:id="@+id/addToCartBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_primary"
            android:text="Add to cart"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/montserrat_semibold" />

    </LinearLayout>

</FrameLayout>
