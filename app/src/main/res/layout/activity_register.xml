<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chimatcha_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:paddingTop="60dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create an\naccount"
            android:textColor="@color/chimatcha_text_white"
            android:textSize="36sp"
            android:fontFamily="serif"
            android:layout_marginBottom="36dp" />

        <!-- Username/Email Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/usernameInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/username_hint"
                android:inputType="text"
                android:background="@drawable/input_bg"
                android:paddingStart="50dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:textColorHint="@color/chimatcha_text_hint"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:paddingStart="50dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:textColorHint="@color/chimatcha_text_hint"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirmPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/confirm_password_hint"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:paddingStart="50dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:textColorHint="@color/chimatcha_text_hint"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Terms text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By clicking the Register button, you agree\nto the public offer"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- Register Button -->
        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/register_btn"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:background="@drawable/btn_primary"
            android:layout_marginBottom="28dp" />

        <!-- OR Continue with -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/or_continue"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Social Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <ImageButton
                android:id="@+id/googleBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/social_btn_bg"
                android:src="@drawable/ic_google"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/appleBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/social_btn_bg"
                android:src="@drawable/ic_apple"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/facebookBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/social_btn_bg"
                android:src="@drawable/ic_facebook"
                android:scaleType="center" />

        </LinearLayout>

        <!-- Login link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I Already Have an Account"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/loginText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Login"
                android:textColor="@color/chimatcha_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
