<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chimatcha_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="90dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome To"
            android:fontFamily="@font/montaga_regular"
            android:textColor="@color/chimatcha_text_white"
            android:textSize="48sp"
            android:lineHeight="52sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="60dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi Matcha!"
                android:fontFamily="@font/montaga_regular"
                android:textColor="@color/chimatcha_text_white"
                android:textSize="48sp"
                android:lineHeight="52sp"/>

            <ImageView
                android:layout_width="42dp"
                android:layout_height="39dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_chimatcha_logo"/>

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/input_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_person"
                android:layout_alignParentStart="true" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="@font/montserrat_medium"
                android:hint="Username or Email"
                android:inputType="textEmailAddress"
                android:paddingStart="48dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:textColorHint="@color/chimatcha_text_hint"
                android:textSize="12sp" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/input_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_lock"
                android:layout_alignParentStart="true" />

            <ImageView
                android:id="@+id/passwordToggle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_eye"
                android:layout_alignParentEnd="true"
                android:clickable="true"
                android:focusable="true" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Password"
                android:inputType="textPassword"
                android:background="@null"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:textColor="#333333"
                android:textColorHint="@color/chimatcha_text_hint"
                android:textSize="12sp"
                android:fontFamily="@font/montserrat_medium"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/forgotPasswordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Forgot Password?"
            android:textColor="@color/chimatcha_primary"
            android:textSize="12sp"
            android:layout_marginBottom="38dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:textAllCaps="false"
            android:text="Login"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_semibold"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:layout_marginBottom="84dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="OR Continue with"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/montserrat_medium"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <ImageButton
                android:id="@+id/googleBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/social_btn_bg"
                android:src="@drawable/ic_google"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/appleBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/social_btn_bg"
                android:src="@drawable/ic_apple"
                android:scaleType="center" />

            <ImageButton
                android:id="@+id/facebookBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/social_btn_bg"
                android:src="@drawable/ic_facebook"
                android:scaleType="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create an account?"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginRight="1dp"
                android:fontFamily="@font/montserrat_medium"/>

            <TextView
                android:id="@+id/signUpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sign Up"
                android:textColor="@color/chimatcha_primary"
                android:textSize="14sp"
                android:fontFamily="@font/montserrat_bold"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
