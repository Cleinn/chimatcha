<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chimatcha_bg"
    android:orientation="vertical"
    android:paddingTop="90dp"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot\npassword?"
        android:textColor="@color/chimatcha_text_white"
        android:textSize="36sp"
        android:fontFamily="@font/montaga_regular"
        android:layout_marginBottom="36dp" />

    <!-- Email Field -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/input_bg">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_email"
            android:layout_alignParentStart="true" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Enter your email address"
            android:inputType="textEmailAddress"
            android:background="@null"
            android:paddingStart="48dp"
            android:paddingEnd="16dp"
            android:textColor="#333333"
            android:textColorHint="@color/chimatcha_text_hint"
            android:textSize="15sp"
            android:fontFamily="@font/montserrat_medium" />

    </RelativeLayout>

    <!-- Hint text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="* We will send you a message to set or reset\nyour new password"
        android:textColor="@color/chimatcha_text_hint"
        android:textSize="12sp"
        android:fontFamily="@font/montserrat_regular"
        android:layout_marginBottom="32dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/submitButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Submit"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:fontFamily="@font/montserrat_medium"
        android:background="@drawable/btn_primary" />

</LinearLayout>
