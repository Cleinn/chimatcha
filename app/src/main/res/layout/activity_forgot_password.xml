<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chimatcha_bg"
    android:orientation="vertical"
    android:padding="28dp"
    android:paddingTop="60dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot\npassword?"
        android:textColor="@color/chimatcha_text_white"
        android:textSize="36sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:layout_marginBottom="36dp" />

    <!-- Email Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:background="@drawable/input_bg"
            android:paddingStart="50dp"
            android:paddingEnd="16dp"
            android:textColor="#333333"
            android:textColorHint="@color/chimatcha_text_hint"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Hint text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="* We will send you a message to set or reset\nyour new password"
        android:textColor="@color/chimatcha_text_hint"
        android:textSize="12sp"
        android:layout_marginBottom="32dp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/submitButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/submit_btn"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:background="@drawable/btn_primary" />

</LinearLayout>
