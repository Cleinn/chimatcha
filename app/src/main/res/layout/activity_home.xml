<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chimatcha_bg">

    <!-- ========== MAIN SCROLLABLE CONTENT ========== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chimatcha_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TOP BAR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:layout_marginBottom="14dp">

                <ImageButton
                    android:id="@+id/hamburgerButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_hamburger"
                    android:background="@null"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Chi Matcha"
                    android:textColor="@color/chimatcha_text_white"
                    android:textSize="20sp"
                    android:fontFamily="@font/maname_regular" />

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_profile"
                    android:background="@drawable/social_btn_bg"
                    android:padding="6dp" />

            </RelativeLayout>

            <!-- WELCOME TEXT -->
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                android:text="Welcome, User!"
                android:textColor="@color/chimatcha_text_white"
                android:textSize="32sp"
                android:fontFamily="@font/montaga_regular" />

            <!-- CAROUSEL -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/carouselViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nestedScrollingEnabled="false" />

                <!-- Previous Button -->
                <ImageButton
                    android:id="@+id/carouselPrevBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_arrow_left"
                    android:background="@drawable/carousel_btn_bg"
                    android:contentDescription="Previous" />

                <!-- Next Button -->
                <ImageButton
                    android:id="@+id/carouselNextBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_arrow_right"
                    android:background="@drawable/carousel_btn_bg"
                    android:contentDescription="Next" />

                <!-- Dots indicator -->
                <LinearLayout
                    android:id="@+id/dotsIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal" />

            </RelativeLayout>

            <!-- BEST SELLING TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:text="Best Selling"
                android:textColor="@color/chimatcha_text_white"
                android:textSize="24sp"
                android:fontFamily="@font/montaga_regular" />

            <!-- BEST SELLING LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bestSellingRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- ===== OUR REPUTATION SECTION ===== -->

            <!-- Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:text="Our Reputation"
                android:textColor="@color/chimatcha_text_white"
                android:textSize="24sp"
                android:fontFamily="@font/montaga_regular" />

            <!-- Reviews Horizontal RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reputationRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ========== DROPDOWN FLOATS OVER CONTENT ========== -->
    <LinearLayout
        android:id="@+id/dropdownMenu"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="60dp"
        android:orientation="vertical"
        android:background="@drawable/dropdown_bg"
        android:visibility="gone"
        android:elevation="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/menuHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="24dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home"
                android:tint="#1B4332"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#1B4332"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_medium" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Menu -->
        <LinearLayout
            android:id="@+id/menuItems"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="24dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_heart"
                android:tint="#1B4332"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textColor="#1B4332"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_medium" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Branch -->
        <LinearLayout
            android:id="@+id/menuBranch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="24dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_branch"
                android:tint="#1B4332"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Branch"
                android:textColor="#1B4332"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_medium" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Log Out -->
        <LinearLayout
            android:id="@+id/menuLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="24dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_logout"
                android:tint="#1B4332"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log Out"
                android:textColor="#1B4332"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_medium" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
