<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ChiMatcha" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/chimatcha_primary</item>
        <item name="colorPrimaryVariant">@color/chimatcha_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/chimatcha_primary</item>
        <item name="colorSecondaryVariant">@color/chimatcha_bg</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/chimatcha_bg</item>
        <item name="android:windowBackground">@color/chimatcha_bg</item>
    </style>

    <style name="RoundedLeftCorners" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">12dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
    </style>
</resources>